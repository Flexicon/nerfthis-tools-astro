---
import Layout from '../layouts/Layout.astro';
import TokenCounter from '../components/TokenCounter.astro';

export const prerender = true;
---

<Layout title="Token Counter - NerfThis Tools">
  <div class="px-6 py-12 mt-12 text-center">
    <h1 class="text-5xl font-bold mb-5">🧠 LLM Token Counter</h1>
    <div class="text-xl font-light lg:w-1/2 mx-auto">
      <p class="mb-3">Paste or type text and get a live token estimate for LLM usage.</p>
    </div>
  </div>

  <div class="px-3 mx-auto sm:w-11/12 md:w-3/4 lg:w-3/5 xl:w-1/2 2xl:w-2/5 mb-12">
    <TokenCounter />
  </div>

  <div class="px-6 py-8 mx-auto mb-12 sm:w-11/12 md:w-3/4 lg:w-3/5 xl:w-1/2 2xl:w-2/5">
    <div class="text-sm text-gray-600 space-y-3">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">How this estimate works</h2>
      <p>
        Different models split text into tokens differently. This tool gives a fast client-side estimate that is
        useful for planning prompt size.
      </p>
      <p>
        For precise numbers, use the tokenizer for your specific target model before final usage in production.
      </p>
    </div>
  </div>
</Layout>
