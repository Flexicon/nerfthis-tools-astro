---
import Layout from "../layouts/Layout.astro";
import TokenCounter from "../components/TokenCounter.astro";

export const prerender = true;
---

<Layout title="Token Counter - NerfThis Tools">
  <div class="px-6 py-12 mt-12 text-center">
    <h1 class="text-5xl font-bold mb-5">
      <span aria-hidden="true">🧠</span>
      <span>LLM </span><span style="view-transition-name: tool-title-tokens">Token Counter</span>
    </h1>
    <div class="text-xl font-light lg:w-1/2 mx-auto">
      <p class="mb-3">Paste or type text and get a live token estimate for LLM usage.</p>
    </div>
  </div>

  <div class="px-3 mx-auto sm:w-11/12 md:w-3/4 lg:w-3/5 xl:w-1/2 2xl:w-2/5 mb-12">
    <TokenCounter />
  </div>

  <div class="px-6 py-8 mx-auto mb-12 sm:w-11/12 md:w-3/4 lg:w-3/5 xl:w-1/2 2xl:w-2/5">
    <div class="text-sm text-gray-600 space-y-3">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">How this count works</h2>
      <p>
        This tool counts tokens client-side in your browser using <a
          href="https://github.com/niieani/gpt-tokenizer#readme"
          class="text-blue-600 hover:underline">gpt-tokenizer</a
        >. No text gets sent anywhere.
      </p>
      <p>Claude, Gemini, and other models may split the same text differently. Tokenizers are annoying like that.</p>
    </div>
  </div>
</Layout>
