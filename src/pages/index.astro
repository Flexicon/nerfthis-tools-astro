---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const tools = [
  {
    href: "/ip",
    icon: "🏠",
    title: "IP Address",
    description: "See your current IP address and geolocation details.",
  },
  {
    href: "/unicode",
    icon: "🔤",
    title: "Unicode to HTML",
    description: "Convert Unicode text, emojis, and special characters to HTML entities.",
  },
  {
    href: "/tokens",
    icon: "🧠",
    title: "Token Counter",
    description: "Estimate how many LLM tokens your prompt or pasted text will use.",
  },
];
---

<Layout title="NerfThis Tools">
  <div class="px-6 py-12 mt-12 text-center">
    <h1 class="text-5xl font-bold mb-5">Hi there 👋</h1>
    <div class="text-xl font-light max-w-[450px] sm:max-w-[700px] mx-auto">
      <p class="mb-5">
        This website was built with the end goal of providing a small collection
        of simple tools to make everyday life on the web a tiny bit easier. At
        least for myself.
      </p>
      <p>Pick a tool. Do the thing. Move on.</p>
    </div>
  </div>

  <section class="px-3 mx-auto sm:w-11/12 md:w-3/4 lg:w-3/5 xl:w-1/2 2xl:w-2/5 mb-16" aria-labelledby="tools-heading">
    <div class="mb-5">
      <h2 id="tools-heading" class="text-2xl font-semibold text-gray-900">Tools</h2>
      <p class="text-gray-600">Small, boring utilities that help get the job done.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            class="group block rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
          >
            <div class="mb-4 flex items-start justify-between gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-gray-100 text-2xl transition group-hover:bg-blue-50">
                {tool.icon}
              </div>
              <span class="text-xl text-gray-300 transition group-hover:translate-x-0.5 group-hover:text-blue-600" aria-hidden="true">
                →
              </span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-700">{tool.title}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-600">{tool.description}</p>
            <span class="sr-only">Open {tool.title}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
